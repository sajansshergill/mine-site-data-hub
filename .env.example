# TimescaleDB / Postgres
POSTGRES_USER=minehub
POSTGRES_PASSWORD=change-me
POSTGRES_DB=minehub
POSTGRES_HOST=timescaledb
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://minehub:change-me@timescaledb:5432/minehub
PSYCOPG_DSN=postgresql://minehub:change-me@timescaledb:5432/minehub

# Redis
REDIS_URL=redis://redis:6379/0

# Kafka / Redpanda
KAFKA_BOOTSTRAP=redpanda:9092
SCHEMA_REGISTRY_URL=http://redpanda:8081

# MQTT
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_TOPIC=fleet/#

# Plant simulators / connectors
OPCUA_ENDPOINT=opc.tcp://sim-plant-opcua:4840/minehub/plant
MODBUS_HOST=sim-plant-modbus
MODBUS_PORT=5020

# Paths inside containers
CONFIG_DIR=/app/config
SCHEMA_DIR=/app/schemas
DROP_DIR=/app/data/drop
REPORT_DIR=/app/reporting/output

# API auth: role:key pairs (viewer < engineer < admin)
API_KEYS=viewer:viewer-key,engineer:engineer-key,admin:admin-key

# Metrics / logging
METRICS_PORT=9100
LOG_LEVEL=INFO
SITE_TZ=America/Los_Angeles

# dbt
DBT_HOST=timescaledb

# Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
GF_USERS_ALLOW_SIGN_UP=false

# SMTP (shift reports)
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM=minehub@demo.local
SMTP_TO=shift-superintendent@demo.local
SMTP_USER=
SMTP_PASSWORD=

# Simulator knobs
FAULT_RATE=0.05
SIM_SPEED=1.0
