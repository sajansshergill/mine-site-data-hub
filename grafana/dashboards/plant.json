  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Crusher throughput (1-min)",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "postgres",
        "uid": "timescaledb"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT bucket AS time, tag_name, avg_value AS value FROM raw.plant_tags_1m WHERE tag_name LIKE 'crusher%' AND bucket > now() - interval '12 hours' ORDER BY bucket",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
